\f6\i \cf13 // api-gateway \uc0\u8594  trip-service               \
\pard\intbl\itap1\pardeftab720\pardirnatural\partightenfactor0

\f5\i0 \cf4 service\cf3  \cf4 TripService\cf3  \{                                                                                                                \
  \cf4 rpc\cf3  \cf9 PreviewTrip\cf3 (\cf4 PreviewTripRequest\cf3 ) \cf4 returns\cf3  (\cf4 PreviewTripResponse\cf3 );\
  \cf4 rpc\cf3  \cf9 CreateTrip\cf3 (\cf4 CreateTripRequest\cf3 ) \cf4 returns\cf3  (\cf4 CreateTripResponse\cf3 ); \}                                                                                                                                     \
                                                                                                                                     \
\pard\intbl\itap1\pardeftab720\pardirnatural\partightenfactor0

\f6\i \cf13 // api-gateway schickt: userID + zwei Koordinaten                   \
\pard\intbl\itap1\pardeftab720\pardirnatural\partightenfactor0

\f5\i0 \cf4 message\cf3  \cf4 PreviewTripRequest\cf3  \{  \cf5 string\cf3  \cf4 userID \cf5 =\cf3  \cf11 1\cf3 ;                                                                                                       \
 \cf4 Coordinate\cf3  \cf4 startLocation\cf3  \cf5 =\cf3  \cf11 2\cf3 ; \cf4 Coordinate\cf3  \cf4 endLocation \cf5 =\cf3  \cf11 3\cf3 ;\}                                                                                                                                          \
                                                                                                                                   \
 
\f6\i \cf13 // trip-service antwortet: berechnete Route + 4 Preisoptionen\

\f5\i0 \cf4 message\cf3  \cf4 PreviewTripResponse\cf3  \{ \cf5 string\cf3  \cf4 tripID\cf3  \cf5 =\cf3  \cf11 1\cf3 ;                                                                                                        \
 \cf4 Route\cf3   \cf4 route\cf3      \cf5 =\cf3  \cf11 2\cf3 ; \cf4 repeated\cf3  \cf4 RideFare\cf3  \cf4 rideFares\cf3  \cf5 =\cf3  \cf11 3\cf3 ; \}                                                                                                                                                                                                                                                                                                                                                                                                   
\f6\i \cf13 // api-gateway schickt: gew\'e4hltes Fare + userID zur Validierung\

\f5\i0 \cf4 message\cf3  \cf4 CreateTripRequest\cf3  \{\cf5 string \cf4 rideFareID\cf3  \cf5 =\cf3  \cf11 1\cf3 ; \cf5 string\cf3  \cf4 userID\cf3  \cf5 =\cf11 2\cf3 ; \}                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
\f6\i \cf13 // trip-service antwortet: nur die tripID \'97 Details kommen sp\'e4ter per Async Event\

\f5\i0 \cf4 message\cf3  \cf4 CreateTripResponse\cf3  \{\cf5  string\cf3  \cf4 tripID\cf3  \cf5 =\cf3  \cf11 1\cf3 ; \cf4 Trip trip\cf3  \cf5 =\cf3  \cf11 2\cf3 ; \}                                                                                                                                                                                                                                                                                                                                                                                                         
\f6\i \cf13 // kommt von Mapbox [lng, lat] \'97 wird in ToProto() konvertiert      \

\f5\i0 \cf4 message\cf3  \cf4 Coordinate\cf3  \{ \cf4 double\cf3  \cf4 latitude\cf3   \cf5 =\cf3  \cf11 1\cf3 ; \cf4 double\cf3  \cf4 longitude\cf3  \cf5 =\cf3  \cf11 2\cf3 ; \}\
                                                                                                                                                                                                                                                                        
\f6\i \cf13 // h\'e4lt die Wegpunkte der Route als Array                           \

\f5\i0 \cf4 message\cf3  \cf4 Geometry\cf3  \{ \cf4 repeated\cf3  \cf4 Coordinate\cf3  \cf4 coordinates\cf3  \cf5 =\cf3  \cf11 1\cf3 ; \}                                                                                                                                              
\f6\i \cf13 // kommt direkt von Mapbox Directions API \'97 distance in Metern, duration in Sekunden                                                 \

