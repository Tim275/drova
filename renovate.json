{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:best-practices",
    "helpers:pinGitHubActionDigests",
    "group:goOpenapi",
    "group:linters",
    "group:monorepos",
    "group:recommended"
  ],

  "configMigration": true,
  "forkProcessing": "disabled",
  "platformCommit": "disabled",
  "platformAutomerge": false,
  "automerge": false,

  "internalChecksAsSuccess": true,
  "rebaseWhen": "behind-base-branch",
  "rebaseLabel": "rebase",
  "stopUpdatingLabel": "stop-updating",
  "semanticCommits": "enabled",

  "separateMinorPatch": true,
  "separateMultipleMajor": false,
  "fetchChangeLogs": "branch",

  "gitIgnoredAuthors": [
    "29139614+renovate[bot]@users.noreply.github.com",
    "noreply@github.com",
    "tim275@users.noreply.github.com",
    "sagichdirnicht259@outlook.de"
  ],

  "assigneesFromCodeOwners": true,
  "reviewersFromCodeOwners": true,

  "schedule": ["* * * * *"],
  "timezone": "Europe/Berlin",
  "prConcurrentLimit": 20,
  "prHourlyLimit": 4,
  "branchConcurrentLimit": 25,

  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "dependencyDashboardTitle": "🔄 Drova Renovate Dashboard",
  "dependencyDashboardOSVVulnerabilitySummary": "all",
  "osvVulnerabilityAlerts": true,

  "labels": ["renovate"],
  "prHeader": "📦 Drova Dependency Update — review CHANGELOG before merge.",

  "enabledManagers": [
    "gomod",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "custom.regex"
  ],

  "customManagers": [
    {
      "customType": "regex",
      "description": "KEDA CRD version pinned in the e2e workflow (keep in sync with deployed KEDA)",
      "managerFilePatterns": [
        "/^\\.github/workflows/e2e-tests\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+KEDA_VERSION=(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    }
  ],

  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],

  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "deploy/**"
  ],

  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["renovate", "security"],
    "schedule": ["at any time"],
    "automerge": false,
    "minimumReleaseAge": "0 days",
    "prCreation": "immediate"
  },

  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on sunday"],
    "automerge": false
  },

  "packageRules": [
    {
      "description": "BLOCK: K8s-core (Talos manages cluster, NOT this repo)",
      "matchPackageNames": [
        "/^kubernetes$/",
        "/^k8s.io/",
        "/registry.k8s.io/kube-/",
        "/etcd-io/etcd/"
      ],
      "enabled": false
    },

    {
      "description": "Type-label: digest (hash-pin, no behavior change)",
      "matchUpdateTypes": ["digest"],
      "minimumReleaseAge": "0 days",
      "addLabels": ["digest"]
    },
    {
      "description": "Type-label: patch (3d soak)",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "addLabels": ["patch"]
    },
    {
      "description": "Type-label: minor (7d soak)",
      "matchUpdateTypes": ["minor"],
      "minimumReleaseAge": "7 days",
      "addLabels": ["minor"]
    },
    {
      "description": "Type-label: major (14d soak)",
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "addLabels": ["major"]
    },

    {
      "description": "Extra soak: Database drivers + images (7d, data integrity)",
      "matchPackageNames": [
        "/jackc/pgx/",
        "/jackc/pgconn/",
        "/go.mongodb.org/mongo-driver/",
        "/redis/go-redis/",
        "/^postgres$/",
        "/^mongo$/",
        "/^mysql$/",
        "/^mariadb$/",
        "/^redis$/"
      ],
      "matchUpdateTypes": ["patch", "minor", "major"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Extra soak: Payment libs (10d, financial integrity)",
      "matchPackageNames": ["/stripe/"],
      "minimumReleaseAge": "10 days"
    },

    {
      "description": "RELEASE-PLEASE: All deps → chore(deps): (no release bump)",
      "matchManagers": ["gomod", "dockerfile"],
      "matchUpdateTypes": ["patch", "minor", "major", "digest", "pin", "pinDigest"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "RELEASE-PLEASE: CI tooling → chore(ci):",
      "matchManagers": ["github-actions", "custom.regex"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci"
    },
    {
      "description": "RELEASE-PLEASE: Dev-stack → chore(dev):",
      "matchManagers": ["docker-compose"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "dev"
    },
    {
      "description": "RELEASE-PLEASE: CVE alerts → fix(deps): (auto-release on merge)",
      "matchManagers": ["gomod", "dockerfile"],
      "isVulnerabilityAlert": true,
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    }
  ]
}
